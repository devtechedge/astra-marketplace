# Required for production database mode. For quick local portfolio review, the app runs with seeded demo data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/astra_marketplace?schema=public"

# Used for the origin allowlist on mutating /api requests (host must match when Origin is present).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signs the HMAC astra-session cookie. Required in real deploys; a demo fallback exists in code if unset.
APP_SECRET="replace-with-a-long-random-secret"

PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
S3_ENDPOINT=""
S3_BUCKET=""
EMAIL_PROVIDER="mock"
SMS_PROVIDER="mock"

# Shared secret for POST /api/payments/webhook (header x-astra-webhook-secret). Demo fallback exists in code if unset.
PAYMENT_WEBHOOK_SECRET="replace-with-a-long-random-secret"
